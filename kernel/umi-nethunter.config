# Delta applied on top of umi-mainline/config/umi.config for a Kali rootfs.
#
# umi-mainline forces its built-in cmdline (CONFIG_CMDLINE_FORCE=y) because its
# own initramfs switch_roots to a device path baked into the initramfs. A Kali
# image boots through the stock initramfs-tools flow, which needs
# root=UUID=... from the bootloader, so the bootloader cmdline must reach the
# kernel. On arm64 this is a choice, not an "extend" flag: the built-in string
# is used *instead of* the bootloader's, or only when the bootloader is silent.
#
# Everything umi needs on the cmdline (console=, pd_ignore_unused,
# clk_ignore_unused, regulator_ignore_unused, arm-smmu.disable_bypass=0) is
# therefore passed by the boot image; see nethunter/patches/0003.
CONFIG_CMDLINE_FROM_BOOTLOADER=y
# CONFIG_CMDLINE_FORCE is not set

# A systemd rootfs and the usual NetHunter container workflows expect these
# built in; arm64 defconfig leaves them as modules or disables them.
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_VETH=y
CONFIG_TUN=y
CONFIG_BRIDGE=y

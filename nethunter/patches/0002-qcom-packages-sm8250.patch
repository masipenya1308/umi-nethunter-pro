diff --git a/devices/qcom/umi/initramfs-tools/umi.conf b/devices/qcom/umi/initramfs-tools/umi.conf
new file mode 100644
index 0000000..e0a2209
--- /dev/null
+++ b/devices/qcom/umi/initramfs-tools/umi.conf
@@ -0,0 +1,6 @@
+# Xiaomi Mi 10 (umi). Both the UFS block driver and ext4 are built into the
+# umi kernel, so the initramfs only needs the modules the root mount asks for.
+# The Android boot ramdisk slot on this device is small; MODULES=most does not
+# fit comfortably. gzip is what the other umi boot images use.
+MODULES=dep
+COMPRESS=gzip
